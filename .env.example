# Copy this file to .env and fill in your values:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Linux/Mac)
#
# Local mode: no AWS — same keys work locally as on server.

# ============================================================
# REQUIRED for bots (at least one of Kraken or Alpaca)
# ============================================================

# Kraken — required for crypto bots (BTC/USD, ETH/USD, etc.)
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Alpaca Paper — required for stock bots. Get free keys at alpaca.markets
ALPACA_API_KEY_PAPER=
ALPACA_API_SECRET_PAPER=

# Alpaca Live — optional, for real-money stock trading
ALPACA_API_KEY_LIVE=
ALPACA_API_SECRET_LIVE=

# Enable Alpaca live client at startup (set to 1 when using live stock bots)
LIVE_TRADING_ENABLED=0

# Allow placing real orders (server guardrail). Set 1 when ready for live.
ALLOW_LIVE_TRADING=1
RECO_PROFILE=aggressive
SCAN_PARALLEL_WORKERS=3
BTC_DOMINANCE_GATE=62
RISK_ENGINE_ENABLED=1

# ============================================================
# OPTIONAL (have sensible defaults)
# ============================================================

# Alpaca data feed for stock bars.
# iex = free tier (default). Set to "iex" if you see "0 candles" for valid tickers.
ALPACA_DATA_FEED=iex

# ── Security (REQUIRED for live trading) ──
# UI login: set a strong password; leave empty for no password (dev only)
# UI_PASSWORD=changeme
# UI_SESSION_SECRET (random 32+ char hex; auto-generated if blank but won't persist across restarts)
# UI_SESSION_SECRET=
# UI_SESSION_TTL_SEC=86400
# UI_REMEMBER_TTL_SEC=1209600

# API auth: set a strong token (>= 32 random chars, hex/base64 recommended).
# This is REQUIRED before any bot can be promoted to live trading. Without it
# the live trading endpoints are disabled and bots stay paused on Go Live.
# Generate one with PowerShell:
#   [guid]::NewGuid().ToString('N') + [guid]::NewGuid().ToString('N')
# Or with Python:
#   python -c "import secrets; print(secrets.token_hex(32))"
# WORKER_API_TOKEN=
# API_ALLOWED_HOSTS=localhost,127.0.0.1,::1,3.151.143.63

# ── Execution Gate (safety for live trading) ──
# Global max spread % before blocking trades (0.008 = 0.8%)
# EXECUTION_MAX_SPREAD_PCT=0.008
# Max spread for market orders (tighter than limit orders)
# MARKET_ORDER_MAX_SPREAD_PCT=0.003
# Max ticker age in seconds before blocking (120 = 2 min)
# STALE_TICKER_MAX_SEC=120
# Max candle age in seconds (10800 = 3 hours)
# STALE_CANDLE_MAX_SEC=10800
# Min 24h USD volume to allow trades (0 = disabled)
# EXECUTION_MIN_VOLUME_24H=0
# Max estimated slippage in basis points for market orders
# MAX_SLIPPAGE_BPS=50
# Set to 0 to disable the execution gate entirely (NOT recommended)
# EXECUTION_GATE_ENABLED=1

# ── Database ──
# BOT_DB_PATH=botdb.sqlite3
# WAL TRUNCATE checkpoint interval for the daemon started by worker_api (seconds).
# BOT_WAL_CHECKPOINT_INTERVAL_SEC=60

# ── Rate limiting ──
# RATE_LIMIT_REQUESTS=0
# RATE_LIMIT_WINDOW_SEC=60

# ── Market Scanner / Purposed Entry ──
# Minimum confidence (0-1) for a setup to be marked READY (EdgeScore threshold)
# MIN_ENTRY_CONFIDENCE=0.65
# Minimum P(TP before SL) from rule-based or ML estimator
# MIN_P_TP_BEFORE_SL=0.55
# Reject entry if current move is in steep selloff (ATR% relative)
# MAX_ALLOWED_DRAWDOWN_ENTRY_PCT=2.0
# Enable scanner watchlist for "good but not ready" symbols
# WATCHLIST_ENABLED=1
# Autopilot mode: STRICT_READY (only bots when READY) or ALLOW_WATCH_DRYRUN
# AUTOPILOT_MODE=STRICT_READY
# ML training lookback in days for edge predictor
# ML_TRAIN_LOOKBACK_DAYS=180
# Prediction horizon for forward return labels (e.g. 4h, 1d)
# PREDICTION_HORIZON=4h
# ADX threshold to distinguish trending vs choppy markets
# ADX_TREND_THRESHOLD=20

# ── Intelligence / ML ──
# Enable ML predictions in recommendation scoring (ml_predictor + ml_ensemble)
# ENABLE_ML_PREDICTIONS=1
# Risk engine: block trades when exposure/loss limits exceeded (default: enabled)
# RISK_ENGINE_ENABLED=1
# Block meme/low-quality coins from screener (BLOCK_MEME_COINS=1)
# BLOCK_MEME_COINS=1

# ── Explore / recommendation scan mix ──
# Max crypto pairs per scan slice (stocks fill remaining slots up to RECO_MAX_SYMBOLS).
# Default 140 — was 50, which skewed live picks toward equities.
# RECO_SCAN_CRYPTO_CAP=140
# RECO_MAX_SYMBOLS=600

# ── Scan performance (worker thread pool + batching) ──
# Parallel workers (I/O-bound). Default scales with CPU (4–16).
# SCAN_PARALLEL_WORKERS=8
# Futures per batch = SCAN_PARALLEL_WORKERS * SCAN_BATCH_SIZE_MULT (default mult=5).
# SCAN_BATCH_SIZE_MULT=5
# Inter-batch sleep (seconds). Lower = faster; raise if Alpaca/Kraken returns 429.
# SCAN_BATCH_SLEEP_STOCK_SEC=0.2
# SCAN_BATCH_SLEEP_CRYPTO_SEC=0.06
# SCAN_BATCH_SLEEP_RL_MID_SEC=3
# SCAN_BATCH_SLEEP_RL_HIGH_SEC=10
# RSS guardrails (MB). Baseline process is often 600–1200MB; do NOT set a 400MB “limit” or scans abort immediately.
# Soft = pause + GC only; Hard = stop scan (OOM). Legacy SCAN_MEMORY_LIMIT_MB only applies if >= 800.
# SCAN_MEMORY_SOFT_MB=1600
# SCAN_MEMORY_HARD_MB=3200
# Reuse SPY/BTC benchmark OHLCV across symbols (seconds).
# SCAN_BENCHMARK_CACHE_TTL_SEC=120

# ── Explore tab smart picks (feed ranking) ──
# Re-rank DB candidates by conviction + freshness + 24h move + 90d backtest; diversify strategies.
# EXPLORE_SMART_RANK=1
# EXPLORE_FEED_FETCH_MULT=6
# EXPLORE_MAX_PER_STRATEGY=5
# EXPLORE_LIVE_STRAT_RANK=1
# EXPLORE_STRICT_BUY=1
# EXPLORE_STRICT_EARNINGS_DAYS=3
# EXPLORE_STRICT_MAX_SPREAD_PCT=0.012
# EXPLORE_STRICT_MIN_CRYPTO_QUOTE_VOL=100000

# ── Discord notifications ──
# Only post Discord messages for real trade lifecycle events (fills, SL/TP, deal closed).
# DISCORD_TRADES_ONLY=1
# Optional: errors / risk pauses (default off to reduce noise)
# DISCORD_NOTIFY_ERRORS=0
# DISCORD_NOTIFY_RISK=0
# Blocked-intelligence / scanner messages (default off)
# DISCORD_NOTIFY_BLOCKED=0
